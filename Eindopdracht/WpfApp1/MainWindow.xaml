<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Rekenspel" Height="450" Width="400"
        Background="LightBlue">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label x:Name="lblSom" FontSize="30" Content="Som komt hier" Margin="10"/>
            <TextBox x:Name="txtAntwoord" Width="120" FontSize="20" Margin="10"/>
            <Button Content="Check antwoord" Click="Check_Click" Margin="10"/>
            <Label x:Name="lblFeedback" FontSize="20" Margin="10"/>
            <Label x:Name="lblScore" Content="Score: 0" Margin="10"/>
            <Button Content="Nieuwe som" Click="NieuweSom_Click" Margin="10"/>
        </StackPanel>
    </Grid>
</Window>